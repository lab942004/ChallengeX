# ChallengeX backend — copy to .env and adjust values.
NODE_ENV=development
PORT=5000

# Database (PostgreSQL) — the ONLY application that connects to the database.
DATABASE_URL=replace-with-your-private-postgresql-connection-string

# Auth
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
JWT_REMEMBER_EXPIRES_IN=30d
JWT_COOKIE_NAME=cx_token
BCRYPT_ROUNDS=10

# CORS / URLs
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Extra comma-separated origins (production domains)
ALLOWED_ORIGINS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# AI (mock = built-in deterministic service, provider = external AI provider)
AI_PROVIDER=mock
AI_API_KEY=

# Password reset email. Leave EMAIL_PROVIDER empty in development:
# reset links are returned by the API / logged instead of emailed.
EMAIL_PROVIDER=
SMTP_URL=
EMAIL_FROM=no-reply@challengex.com

# Seed credentials (used by `npm run prisma:seed`) — never use these in production.
SEED_SUPER_ADMIN_EMAIL=superadmin@challengex.dev
SEED_SUPER_ADMIN_PASSWORD=ChangeMe_SuperAdmin1!
SEED_ADMIN_EMAIL=admin@challengex.dev
SEED_ADMIN_PASSWORD=ChangeMe_Admin1!
